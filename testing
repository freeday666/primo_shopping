        "●  Klaar"
        if returncode == 0
        else "●  Klaar met meldingen"
    )

    status_label.configure(
        foreground=GREEN if returncode == 0 else ORANGE
    )

    window = tk.Toplevel(root)
    window.title(title)
    window.geometry("850x560")
    window.configure(bg=BG)

    window.transient(root)
    window.grab_set()

    tk.Label(
        window,
        text=title,
        font=("Segoe UI", 18, "bold"),
        fg=TEXT,
        bg=BG,
    ).pack(
        anchor="w",
        padx=24,
        pady=(22, 5),
    )

    tk.Label(
        window,
        text=description,
        font=("Segoe UI", 10),
        fg=MUTED,
        bg=BG,
        wraplength=790,
        justify="left",
    ).pack(
        anchor="w",
        padx=24,
        pady=(0, 15),
    )

    text_frame = tk.Frame(
        window,
        bg=CARD,
        highlightbackground=BORDER,
        highlightthickness=1,
    )

    text_frame.pack(
        fill="both",
        expand=True,
        padx=24,
        pady=5,
    )

    text = tk.Text(
        text_frame,
        wrap="word",
        bg=CARD,
        fg="#d9e0ea",
        insertbackground=TEXT,
        relief="flat",
        font=("Cascadia Mono", 9),
        padx=14,
        pady=14,
    )

    text.pack(
        fill="both",
        expand=True,
    )

    text.insert("1.0", output)
    text.configure(state="disabled")

    tk.Button(
        window,
        text="Sluiten",
        command=window.destroy,
        bg=ACCENT,
        fg="white",
        activebackground=ACCENT_HOVER,
        activeforeground="white",
