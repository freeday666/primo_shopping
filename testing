def run_async(command, title, description, timeout=1800):
    """
    Voert een Windows-command uit zonder de GUI te blokkeren.
    """

    def worker():
        try:
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=timeout,
                shell=False,
                creationflags=getattr(
                    subprocess,
                    "CREATE_NO_WINDOW",
                    0
                ),
            )

            output = (result.stdout or "")

            if result.stderr:
                output += "\n\n" + result.stderr

            if not output.strip():
                output = "Opdracht voltooid."

            root.after(
                0,
                lambda: show_result(
                    title,
                    description,
                    result.returncode,
                    output,
                ),
            )

        except subprocess.TimeoutExpired:
            root.after(
                0,
                lambda: show_result(
                    title,
                    description,
                    1,
                    "De opdracht duurde te lang en is gestopt.",
                ),
            )

        except Exception as error:
            root.after(
                0,
                lambda: show_result(
                    title,
                    description,
                    1,
                    str(error),
                ),
            )

    status_var.set(f"●  Bezig met {title}...")
    status_label.configure(foreground=ORANGE)

    threading.Thread(
        target=worker,
        daemon=True,
    ).start()


def show_result(title, description, returncode, output):
