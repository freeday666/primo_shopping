def gpu_reset():
    """
    Windows heeft een ingebouwde GPU-driver reset:
    Win + Ctrl + Shift + B

    We sturen deze toetsencombinatie via PowerShell.
    """

    if not messagebox.askyesno(
        "Graphics Driver Reset",
        "De grafische driver wordt opnieuw geïnitialiseerd.\n\n"
        "Je scherm kan kort zwart worden of knipperen.\n\n"
        "Doorgaan?",
    ):
        return

    try:
        # Win + Ctrl + Shift + B
        import ctypes

        VK_LWIN = 0x5B
        VK_CONTROL = 0x11
        VK_SHIFT = 0x10
        VK_B = 0x42

        KEYEVENTF_KEYUP = 0x0002

        user32 = ctypes.windll.user32

        for key in [VK_LWIN, VK_CONTROL, VK_SHIFT, VK_B]:
            user32.keybd_event(key, 0, 0, 0)

        for key in [VK_B, VK_SHIFT, VK_CONTROL, VK_LWIN]:
            user32.keybd_event(
                key,
                0,
                KEYEVENTF_KEYUP,
                0,
            )

        status_var.set("●  Graphics driver opnieuw geïnitialiseerd")
        status_label.configure(
            foreground=GREEN
        )

    except Exception as error:
        messagebox.showerror(
            "Graphics",
            f"Graphics reset mislukt:\n\n{error}",
        )


