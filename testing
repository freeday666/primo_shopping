def gaming_fix():
    """
    Veilige Windows-optimalisaties:
    - High Performance power plan
    - Windows Game Mode
    - Game DVR uitschakelen
    - GPU timeout verhogen
    - Windows repair
    """

    answer = messagebox.askyesno(
        "Gaming Fix",
        "FreddoDev gaat enkele Windows-instellingen aanpassen "
        "die kunnen helpen tegen haperingen, freezes en crashes tijdens gamen.\n\n"
        "Er worden geen persoonlijke bestanden verwijderd.\n\n"
        "Doorgaan?",
    )

    if not answer:
        return

    commands = (
        'powercfg /setactive SCHEME_MIN '
        '&& reg add "HKCU\\Software\\Microsoft\\GameBar" '
        '/v AllowAutoGameMode /t REG_DWORD /d 1 /f '
        '&& reg add "HKCU\\System\\GameConfigStore" '
        '/v GameDVR_Enabled /t REG_DWORD /d 0 /f '
        '&& reg add "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR" '
        '/v AppCaptureEnabled /t REG_DWORD /d 0 /f '
        '&& reg add "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers" '
        '/v TdrDelay /t REG_DWORD /d 10 /f '
        '&& DISM.exe /Online /Cleanup-Image /RestoreHealth '
        '&& sfc.exe /scannow'
    )

    run_async(
        [
            "cmd.exe",
            "/c",
            commands,
        ],
        "Gaming Fix",
        (
            "Windows gaming-instellingen worden gecontroleerd "
            "en Windows wordt gerepareerd.\n\n"
            "Na afloop is een herstart aanbevolen."
        ),
        timeout=3600,
    )


