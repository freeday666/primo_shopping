def make_button(
    parent,
    text,
    command,
    accent=None,
):
    button = tk.Button(
        parent,
        text=text,
        command=command,
        bg=accent or CARD,
        fg=TEXT,
        activebackground=ACCENT_HOVER if accent else CARD_HOVER,
        activeforeground="white",
        relief="flat",
        bd=0,
        font=("Segoe UI", 10, "bold"),
        anchor="w",
        padx=18,
        pady=12,
        cursor="hand2",
    )

    normal = accent or CARD
    hover = ACCENT_HOVER if accent else CARD_HOVER

    button.bind(
        "<Enter>",
        lambda event: button.configure(
            bg=hover
        ),
    )

    button.bind(
        "<Leave>",
        lambda event: button.configure(
            bg=normal
        ),
    )

    return button


