# CLEANUP / RESET
# ============================================================

def cleanup_user_files():
    """
    Verwijdert standaard gebruikersmappen:
    Downloads
    Pictures
    Screenshots
    Videos
    Documents wordt bewust NIET verwijderd.

    Steam en Discord worden niet aangeraakt.
    """

    user = Path.home()

    folders = {
        "Downloads": user / "Downloads",
        "Pictures": user / "Pictures",
        "Screenshots": user / "Pictures" / "Screenshots",
        "Videos": user / "Videos",
    }

    existing = [
        (name, path)
        for name, path in folders.items()
        if path.exists()
    ]

    if not existing:
        messagebox.showinfo(
            "Opschonen",
            "Er zijn geen geselecteerde mappen gevonden.",
        )
        return

    names = "\n".join(
        f"• {name}: {path}"
        for name, path in existing
    )

    answer = messagebox.askyesno(
        "⚠ Bestanden verwijderen",
        "LET OP: de inhoud van deze mappen wordt verwijderd:\n\n"
        f"{names}\n\n"
        "Steam en Discord worden NIET verwijderd.\n"
        "Documenten worden NIET verwijderd.\n\n"
        "Deze actie kan niet eenvoudig ongedaan worden gemaakt.\n\n"
        "Wil je doorgaan?",
        icon="warning",
    )

    if not answer:
        return

    deleted = 0
    errors = []

    for name, folder in existing:

        # Screenshots zit binnen Pictures.
        # Als Pictures zelf verwijderd wordt, hoeven we Screenshots
        # niet nogmaals te verwijderen.
        if name == "Screenshots" and folders["Pictures"].exists():
            continue

        try:
            for item in folder.iterdir():
                try:
                    if item.is_dir():
                        shutil.rmtree(
                            item,
                            ignore_errors=False,
                        )
                    else:
                        item.unlink(
                            missing_ok=True
                        )

                    deleted += 1

                except Exception as error:
                    errors.append(
                        f"{item}: {error}"
                    )

        except Exception as error:
            errors.append(
                f"{folder}: {error}"
            )

    output = (
        f"Opschonen voltooid.\n\n"
        f"Verwijderde items: {deleted}\n"
        f"Fouten: {len(errors)}\n\n"
        "Steam en Discord zijn ongemoeid gelaten."
    )

    if errors:
        output += "\n\nMeldingen:\n" + "\n".join(errors)

    show_result(
        "Opschonen voltooid",
        "De geselecteerde gebruikersmappen zijn opgeschoond.",
        0 if not errors else 1,
        output,
    )


def reset_freddodev():
    """
    Gecombineerde reset:
    1. Restore point
    2. Cleanup
    3. Windows repair
    """

    answer = messagebox.askyesno(
        "FreddoDev Reset",
