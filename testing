# ============================================================
# WINDOWS 11 - VEILIG OPSCHONEN, REPAREREN & UPDATEN
# PowerShell - Administrator
# ============================================================

$ErrorActionPreference = "Continue"

Clear-Host

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "        WINDOWS 11 ONDERHOUD & REPARATIE" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""

# Administrator controleren
$principal = New-Object Security.Principal.WindowsPrincipal(
    [Security.Principal.WindowsIdentity]::GetCurrent()
)

if (-not $principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {
    Write-Host "FOUT: PowerShell moet als Administrator worden gestart." -ForegroundColor Red
    Read-Host "Druk op Enter"
    exit
}

Write-Host "[1/8] Tijdelijke bestanden opruimen..." -ForegroundColor Yellow

Remove-Item "$env:TEMP\*" -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item "C:\Windows\Temp\*" -Recurse -Force -ErrorAction SilentlyContinue

Write-Host "      Klaar." -ForegroundColor Green


Write-Host ""
Write-Host "[2/8] Windows Update-cache vernieuwen..." -ForegroundColor Yellow

Stop-Service wuauserv -Force -ErrorAction SilentlyContinue
Stop-Service bits -Force -ErrorAction SilentlyContinue

Remove-Item `
    "C:\Windows\SoftwareDistribution\Download\*" `
    -Recurse `
    -Force `
    -ErrorAction SilentlyContinue

Start-Service bits -ErrorAction SilentlyContinue
Start-Service wuauserv -ErrorAction SilentlyContinue

Write-Host "      Klaar." -ForegroundColor Green


Write-Host ""
Write-Host "[3/8] Windows componenten opruimen..." -ForegroundColor Yellow

DISM.exe /Online /Cleanup-Image /StartComponentCleanup

Write-Host "      Klaar." -ForegroundColor Green


Write-Host ""
Write-Host "[4/8] Windows installatie repareren..." -ForegroundColor Yellow

DISM.exe /Online /Cleanup-Image /RestoreHealth

Write-Host "      Klaar." -ForegroundColor Green


Write-Host ""
Write-Host "[5/8] Windows systeembestanden controleren..." -ForegroundColor Yellow

sfc.exe /scannow

Write-Host "      Klaar." -ForegroundColor Green


Write-Host ""
Write-Host "[6/8] C-schijf controleren..." -ForegroundColor Yellow

chkdsk.exe C: /scan

Write-Host "      Klaar." -ForegroundColor Green


Write-Host ""
Write-Host "[7/8] Windows Update openen..." -ForegroundColor Yellow

Start-Process "ms-settings:windowsupdate"

Write-Host "      Windows Update is geopend." -ForegroundColor Green


Write-Host ""
Write-Host "[8/8] Opstartprogramma's beschikbaar maken..." -ForegroundColor Yellow

Start-Process "ms-settings:startupapps"

Write-Host "      Opstart-apps zijn geopend." -ForegroundColor Green


Write-Host ""
Write-Host "============================================================" -ForegroundColor Green
Write-Host "                ONDERHOUD VOLTOOID" -ForegroundColor Green
Write-Host "============================================================" -ForegroundColor Green
Write-Host ""
Write-Host "BELANGRIJK:" -ForegroundColor Yellow
Write-Host "1. Installeer alle beschikbare Windows Updates."
Write-Host "2. Controleer eventueel 'Optionele updates' voor drivers."
Write-Host "3. Start de pc daarna opnieuw op."
Write-Host ""
Write-Host "Persoonlijke bestanden zijn door dit script niet verwijderd." -ForegroundColor Cyan
Write-Host ""

$restart = Read-Host "Wil je Windows nu opnieuw opstarten? (J/N)"

if ($restart -match "^[JjYy]$") {
    Restart-Computer
}
