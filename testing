# ============================================================
# ADMINISTRATOR
# ============================================================

def require_admin():
    if os.name != "nt":
        return

    try:
        if ctypes.windll.shell32.IsUserAnAdmin():
            return
    except Exception:
        pass

    script = str(Path(__file__).resolve())
    args = subprocess.list2cmdline([script, *sys.argv[1:]])

    result = ctypes.windll.shell32.ShellExecuteW(
        None,
        "runas",
        sys.executable,
        args,
        str(Path(script).parent),
        1,
    )

    if result <= 32:
        raise RuntimeError("Administratorrechten konden niet worden aangevraagd.")

    sys.exit()


require_admin()


